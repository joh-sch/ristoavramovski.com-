# =============================================================================
# OS & editor
# =============================================================================

.DS_Store
Thumbs.db
*.log
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace

# =============================================================================
# Node / Composer
# =============================================================================

node_modules/
build-utils/node_modules/
npm-debug.log*
yarn-error.log*

# Kirby core itself is installed via Composer — run: npm run init-kirby.
# getkirby/composer-installer places the CMS in development-site/kirby/, so
# both of these are reproducible from composer.lock and stay out of the repo.
#
# NOTE: composer.lock is intentionally TRACKED so every environment installs
# the exact same Kirby version. Do not add it here.
#
# If you ever deploy by plain FTP rather than by running composer on the
# target, un-ignore development-site/kirby/ — the site cannot boot without it.
development-site/vendor/
development-site/kirby/

# =============================================================================
# Kirby — ignore runtime / installed files, track everything else
# =============================================================================

# Generated thumbnails and asset copies
development-site/media/

# Writable runtime state: accounts, cache, sessions
# (roots are wired up in development-site/index.php)
development-site/storage/

# Local environment config (copy config.localhost.php.example to get started)
development-site/site/config/config.localhost.php
development-site/.env

# Per-environment Kirby config. Kirby loads config.<hostname>.php by request
# host, so these are environment-specific and live on the machine they
# describe — including the server's. See docs/DEPLOYMENT.md.
development-site/site/config/config.*.php
!development-site/site/config/config.php

# Deploy target: names a host and a path. Copy the example and fill it in.
tools/deploy/deploy.config.json

# =============================================================================
# Kirby content
# =============================================================================

# Content is environment/user data and is not deployed from this repository.
# Provide or restore development-site/content/ separately when setting up a
# fresh checkout.
development-site/content/

# =============================================================================
# Built assets (generated by npm run build / watch)
# =============================================================================

development-site/app/app.min.js
development-site/app/app.min.js.map
development-site/app/drawing.min.js
development-site/app/drawing.min.js.map
development-site/app/styles/styles.css

# =============================================================================
# Misc
# =============================================================================

TEMP/

# Source barebone this project was derived from — keep locally, do not commit
temp/
