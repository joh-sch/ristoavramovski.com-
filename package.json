{
  "name": "risto-2026",
  "version": "0.0.0",
  "private": true,
  "description": "Risto 2026 — Kirby 5 website",
  "scripts": {
    "create-comp": "cd build-utils && npm run create-comp --",
    "init-kirby": "node build-utils/scripts/init-kirby.js",
    "updt-version": "node build-utils/scripts/updt-version.js",
    "release": "node tools/release/release.js",
    "deploy": "node tools/deploy/deploy.js",
    "lint": "eslint --no-error-on-unmatched-pattern --cache --cache-location node_modules/.cache/eslint/ development-site/app development-site/site/snippets",
    "tw-watch": "npx @tailwindcss/cli -i ./development-site/app/app.css -o ./development-site/app/styles/styles.css --watch",
    "tw-build": "npx @tailwindcss/cli -i ./development-site/app/app.css -o ./development-site/app/styles/styles.css -m",
    "js-watch": "NODE_ENV=development rollup -c rollup.config.mjs --watch",
    "js-build": "npm run lint && NODE_ENV=production rollup -c rollup.config.mjs",
    "watch": "npm run tw-watch & npm run js-watch",
    "build": "npm run tw-build && npm run js-build",
    "reload": "livereload . --wait 150"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "release": {
    "branch": "devel",
    "changelog": "CHANGELOG.md",
    "tempDir": "TEMP"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "fabric": "^7.4.0",
    "gia": "^1.0.1",
    "regenerator-runtime": "^0.14.1",
    "swup": "^4.10.0",
    "tailwindcss": "^4.3.5",
    "vanilla-lazyload": "^19.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "livereload": "^0.10.3",
    "rollup": "^4.68.8"
  }
}
