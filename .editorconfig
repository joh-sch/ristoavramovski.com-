root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.php]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

# Templates and snippets are markup-first — 2 spaces, matching the HTML around them
[development-site/site/{templates,snippets}/**.php]
indent_size = 2
